# Copy this file to .env (or .env.development.local) and fill in real values.
# .env / .env*.local are gitignored — safe place for anything you don't want committed.
# .env.development / .env.production ARE committed (no secrets in them, just
# public API URLs + build base path) and provide working defaults already.

# Dev server port (vite.config.ts, strictPort) — must match an origin the API allows for CORS
PORT=5173

# Backend API base URL (see src/config/api.config.js)
VITE_API_URL=http://localhost:3001/

# GitHub Pages base path (see vite.config.ts) — only needed if you want to
# override the built-in default (/resume-vuejs-website/)
# BASE_URL=/resume-vuejs-website/
